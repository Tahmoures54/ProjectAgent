# ──────────────────────────────────────────────
# Project Agent — Environment Template (copy to .env)
# NEVER commit real .env with secrets
# ──────────────────────────────────────────────

# Runtime
PMS_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# CRITICAL: use a long random string in production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-secret-key

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///instance/pms.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/project_agent

# ─── Vercel (Project Settings → Environment Variables) ───
# فایل .env به گیت نمی‌رود؛ بدون این‌ها استقرار کرش می‌کند:
# PMS_ENV=production
# SECRET_KEY=<random-48+chars>
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#   یا POSTGRES_URL از اتصال Neon / Vercel Postgres
# OWNER_EMAIL=you@example.com

PMS_AUTO_CREATE_DB=1
AUTO_DB_UPGRADE=1

OWNER_EMAIL=you@example.com
APP_NAME=Project Agent
APP_YEAR=۱۴۰۴
PER_PAGE=20
REMEMBER_COOKIE_DAYS=30

# ─── SMS Notifications ─────────────────────────
# false = only log to sms_logs (status=skipped); console provider still prints in terminal
SMS_ENABLED=false
# console | kavenegar | melipayamak
SMS_PROVIDER=console
SMS_SENDER=

# Feature toggles
SMS_NOTIFY_DAILY_REPORT=true
SMS_NOTIFY_CONCERN=true
SMS_WELCOME_SIGNUP_ENABLED=true
SMS_WELCOME_FIRST_LOGIN_ENABLED=true
SMS_LOGIN_ALERT_ENABLED=true
SMS_FORGOT_PASSWORD_ENABLED=true
SMS_ALLOW_UNVERIFIED_TRANSACTIONAL=true

# Kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=1000xxxx

# Melipayamak
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# MELIPAYAMAK_FROM=
# MELIPAYAMAK_SEND_URL=
# MELIPAYAMAK_MODE=json

# Email (optional)
DEV_EMAIL_CONSOLE=1
