# ──────────────────────────────────────────────
# Project Agent — نمونه متغیرهای محیطی
# این فایل را کپی کنید:  cp env.example .env
# هرگز فایل .env واقعی (با رمز) را commit نکنید.
# ──────────────────────────────────────────────
#
# Vercel: فایل .env به گیت نمی‌رود.
# همین کلیدها را در
#   Project Settings → Environment Variables
# برای Production و Preview وارد کنید.
#
# الزامی برای Vercel:
#   PMS_ENV, SECRET_KEY, DATABASE_URL (یا POSTGRES_URL), OWNER_EMAIL
# ──────────────────────────────────────────────


# ─── الزامی (Vercel / Production) ──────────────
PMS_ENV=production
SECRET_KEY=replace-with-a-secure-secret-key
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL (Neon / Vercel Postgres). SQLite روی Vercel کار نمی‌کند.
# postgres:// هم قبول است؛ برنامه به postgresql+psycopg2:// تبدیل می‌کند.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# POSTGRES_URL=
OWNER_EMAIL=you@example.com
OWNER_EMAILS=you@example.com


# ─── توسعه محلی (اختیاری) ──────────────────────
# PMS_ENV=development
# FLASK_DEBUG=1
# SQLALCHEMY_DATABASE_URI=sqlite:///instance/pms.db
FLASK_APP=app.py
HOST=127.0.0.1
PORT=5000


# ─── دیتابیس / مهاجرت ──────────────────────────
# روی Vercel false بماند
PMS_AUTO_CREATE_DB=0
AUTO_DB_UPGRADE=0


# ─── برند / ظاهر ───────────────────────────────
APP_NAME=Project Agent
APP_YEAR=۱۴۰۴
PER_PAGE=20
REMEMBER_COOKIE_DAYS=30
RESET_TOKEN_MAX_AGE_SECONDS=3600
DEV_EMAIL_CONSOLE=true


# ─── پلن و دوره رایگان ─────────────────────────
FREE_DAYS=90
PRO_TRIAL_DAYS=14
PLAN_BRONZE_YEAR_TOMAN=2880000
PLAN_SILVER_YEAR_TOMAN=9504000
PLAN_GOLD_YEAR_TOMAN=15300000
PLAN_BRONZE_ANNUAL_DISCOUNT_PERCENT=20
PLAN_SILVER_ANNUAL_DISCOUNT_PERCENT=12
PLAN_GOLD_ANNUAL_DISCOUNT_PERCENT=15


# ─── Stripe (اختیاری) ──────────────────────────
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=


# ─── پیامک (اختیاری) ───────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=console
SMS_SENDER=
SMS_NOTIFY_DAILY_REPORT=true
SMS_NOTIFY_CONCERN=true
SMS_WELCOME_SIGNUP_ENABLED=true
SMS_WELCOME_FIRST_LOGIN_ENABLED=true
SMS_LOGIN_ALERT_ENABLED=true
SMS_FORGOT_PASSWORD_ENABLED=true
SMS_ALLOW_UNVERIFIED_TRANSACTIONAL=true

# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=1000xxxx

# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# MELIPAYAMAK_FROM=
# MELIPAYAMAK_SEND_URL=
# MELIPAYAMAK_MODE=json
